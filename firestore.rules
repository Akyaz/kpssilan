rules_version = '2';
// KPSS İlan Takip — Firestore security rules.
// Deploy: Firebase console > Firestore > Rules (paste) or `firebase deploy --only firestore:rules`.
service cloud.firestore {
  match /databases/{database}/documents {

    // Admins are listed as documents admins/{email} (create them in the console).
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && exists(/databases/$(database)/documents/admins/$(request.auth.token.email));
    }

    // Remote config read by every app (also before sign-in); edited from the panel.
    match /config/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // The app stores no user data. Anything not matched above is denied.

    // Admin list: an admin can see that they are one; nobody writes from clients.
    match /admins/{email} {
      allow read: if request.auth != null && request.auth.token.email == email;
      allow write: if false;
    }
  }
}
